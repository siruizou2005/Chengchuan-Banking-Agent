# systemd 服务模板。按需修改用户、路径、端口和域名；密钥（CHAT_API_KEY 等）放在 /etc/chengchuan-bank/env，权限 600。
[Unit]
Description=ChengChuan Bank Agent
After=network.target

[Service]
Type=simple
User=bank-sim
Group=bank-sim
WorkingDirectory=/opt/chengchuan-bank/current
ExecStart=/usr/bin/node server/index.mjs --production
Environment=NODE_ENV=production
Environment=PORT=8316
Environment=BANK_DB=/var/lib/chengchuan-bank/bank.sqlite
Environment=PUBLIC_ORIGIN=https://bank.example.com
Environment=TRUST_PROXY=true
Environment=SESSION_SECURE=true
EnvironmentFile=-/etc/chengchuan-bank/env
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
StateDirectory=chengchuan-bank
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/chengchuan-bank
MemoryMax=384M
TasksMax=64

[Install]
WantedBy=multi-user.target
