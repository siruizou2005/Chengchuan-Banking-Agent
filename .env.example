# 复制为 .env 后填写。全部仅由服务端读取：不要加 VITE_ 前缀，不要提交到版本库。
# npm run dev / npm start 通过 Node 的 --env-file-if-exists=.env 自动加载；shell 中已设置的同名变量优先。

# 聊天模型：OpenAI 兼容接口，需支持 tools（函数调用）。CHAT_BASE_URL 不含 /chat/completions。
CHAT_API_KEY=
CHAT_BASE_URL=https://api.deepseek.com
CHAT_MODEL=deepseek-flash

# 测试
YH_API_KEY=
YH_BASE_URL=

# 语音转文字：阿里云百炼 qwen3-asr-flash。未配置时前端隐藏麦克风按钮。
DASHSCOPE_API_KEY=
ASR_MODEL=qwen3-asr-flash
ASR_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 消息渠道。CHANNEL_SECRET 用于 AES-256-GCM 加密渠道凭据及飞书/微信消息任务，必须是 64 位十六进制：
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
CHANNEL_SECRET=
# 飞书共享机器人（自建应用）凭据，仅银行飞书组织成员可用；两项齐全时服务启动即建立长连接。
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 储户一键创建飞书专属机器人（HTTP 回调，空闲零连接）；还需要 https 的 PUBLIC_ORIGIN。
FEISHU_PERSONAL_ENABLED=false
# 处理期间给用户消息加「Typing」表情，回复送达后撤销；成功时不再发文字进度。
FEISHU_TYPING_ENABLED=true
# 表情添加失败时，飞书请求超过4秒仍未完成提示一次；快速完成不发等待提示。
FEISHU_PROGRESS_AFTER_MS=4000
FEISHU_FEEDBACK_ENABLED=true
# 微信 ClawBot（iLink 直连）开关。
WECHAT_ENABLED=false
# 保持总开关 true，将此项改 false 并重启：停止新绑定/收件，继续排空已接收任务。
WECHAT_ACCEPT_NEW_MESSAGES=true
# 微信收到普通请求后计时，6秒仍未生成结果时只发送一次“正在处理”；快速完成不发文字提示。
# 处理期间另有「正在输入」状态；设 WECHAT_TYPING_ENABLED=false 可关闭，不影响6秒文字提示。
WECHAT_FEEDBACK_ENABLED=true
WECHAT_TYPING_ENABLED=true
WECHAT_PROGRESS_AFTER_MS=6000
# 普通发送超时（500～12000ms）；过程提示固定最多等待2000ms。
WECHAT_SEND_TIMEOUT_MS=8000
WECHAT_MAX_PENDING_PER_USER=3
WECHAT_SEND_CONCURRENCY=4
WECHAT_PROTOCOL_VERSION=2.4.9
WECHAT_UNKNOWN_REVIEW_AFTER_MS=300000
# 金额显示由用户在App「消息渠道绑定」分别设置飞书/微信开关，默认显示金额。
# 旧 CHANNEL_MASK_AMOUNTS 环境变量不再控制渠道显示。

# 全局关闭智能体：true 时拒绝所有工具调用与写操作，只保留银行业务页面。
AGENT_DISABLED=false

# 个性化关闭时保留数据与管理接口，不加载或提取记忆；不用后台模型总结。
PERSONALIZATION_ENABLED=true
# 模块化记忆预算，均为UTF-8字节；Skill与记忆封装共同受总预算限制。
MEMORY_MAX_ITEMS=8
MEMORY_MAX_BYTES=2400
MEMORY_CORE_BYTES=600
MEMORY_MODULE_BYTES=1200
MEMORY_HISTORY_BYTES=600
SKILL_MAX_BYTES=900
CONTEXT_AUGMENTATION_BYTES=3200
# 行为展示假设的最低门槛；不能低于3次独立观察、2个会话。
MEMORY_MIN_EVIDENCE=3
MEMORY_MIN_SESSIONS=2
# 每个数据库共享的模型并发上限、每用户每日(UTC)HTTP请求次数与token预算。
# 一次工具循环可能发出多个HTTP请求；输入以UTF-8字节作保守token上界。
INFERENCE_CONCURRENCY=4
INFERENCE_DAILY_QUOTA=120
INFERENCE_MAX_INPUT_TOKENS=64000
INFERENCE_MAX_OUTPUT_TOKENS=2200
# 按实际聊天供应商价格填写，单位：货币/百万token；未配置或未返回usage则cost为null。
# ASR费用单独按供应商账单核对，不套用聊天单价。
# INFERENCE_INPUT_PRICE_PER_MILLION=
# INFERENCE_OUTPUT_PRICE_PER_MILLION=

# 邮件验证码（Resend）：配置后，已登记真实邮箱的用户收真实验证码；example.com 等演示邮箱始终在页面显示验证码。
# 未验证发信域名时只能用 onboarding@resend.dev，且只能发到 Resend 账户本人的邮箱。
# RESEND_API_KEY=
# OTP_EMAIL_FROM=澄川银行 <no-reply@你的已验证域名>
# 真实发送的每日总量上限（Resend 免费版每天 100 封）；每个邮箱另有60秒一次、每天10次的限制。
OTP_DAILY_LIMIT=90

# 基金产品数据：按需从东方财富公开接口拉取（无需密钥），缓存在SQLite；不可用时回退到 server/fund-snapshot.json。
# false 时只用内置快照，不访问外网。
PRODUCT_DATA_REMOTE=true
PRODUCT_CACHE_MINUTES=360

# 服务运行参数（可选）
# 实名资料与核身凭据加密密钥：64位随机十六进制，仅接入真实核身适配器时需要。
# 生产环境放入 /etc/chengchuan-bank/env；请备份，直接换值会使已有实名资料无法解密。
# IDENTITY_ENCRYPTION_KEY=
# PORT=5173
# BANK_DB=data/bank.sqlite
# PUBLIC_ORIGIN=https://bank.example.com
# TRUST_PROXY=true
# SESSION_SECURE=true
# Risk MVP remains sandbox-only. Enabling live payment aborts startup.
LIVE_PAYMENT_ENABLED=false
RISK_AGE_MODE=shadow
# RISK_POLICY_FILE=/absolute/path/to/approved-age-policy.json
# RISK_REVIEWER_IDS=user-id-1,user-id-2
# PUMA uses the local simulator policy by default. Do not enable live payments.
# PUMA_POLICY_FILE=/absolute/path/to/approved-puma-policy.json
