{
  "name": "chengchuan-bank-simulator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch server/index.mjs",
    "dev:bank": "node --env-file-if-exists=.env --watch server/index.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env server/index.mjs --production",
    "test": "node scripts/test.mjs",
    "test:risk": "node --test tests/risk-mvp.test.mjs",
    "test:puma": "node --test --test-concurrency=2 tests/puma.test.mjs tests/puma-control.test.mjs tests/risk-mvp.test.mjs",
    "replay:puma": "node scripts/replay-puma.mjs",
    "check:puma-ui": "node scripts/check-puma-ui.mjs",
    "demo:risk": "node scripts/demo-risk-mvp.mjs",
    "benchmark:memory": "node scripts/benchmark-memory.mjs",
    "snapshot:products": "node scripts/snapshot-products.mjs"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.74.0",
    "express": "^5.1.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "quickjs-emscripten": "^0.32.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
